# --- Database (Supabase Postgres) ---
# DATABASE_URL: transaction-mode pooler (6543) — used by the app at runtime via the pg driver adapter.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: session-mode pooler (5432) — used by the Prisma CLI for migrations (see prisma.config.ts).
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# --- Supabase Auth + Storage ---
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""   # server-only, never expose to the client

# --- App ---
APP_URL="http://localhost:3000"
DEFAULT_TENANT_SUBDOMAIN="digitallinks"  # used whenever NEXT_PUBLIC_ROOT_DOMAIN is unset, or the request has no subdomain
# NEXT_PUBLIC_ROOT_DOMAIN: set once a custom domain (e.g. talentlink.com) is attached in
# Vercel — enables real per-tenant subdomain routing (acme.talentlink.com). Leave unset to
# keep today's single-tenant behavior on the Vercel-assigned domain.
# NEXT_PUBLIC_ROOT_DOMAIN="talentlink.com"
# PLATFORM_ADMIN_EMAILS: comma-separated emails allowed into /ops (the platform
# console — sees every tenant, not just the one their subdomain resolves to).
# Not a tenant role; deliberately outside the schema so no tenant Admin can grant it.
PLATFORM_ADMIN_EMAILS="talentlinkv1@gmail.com"

# --- Migration script only (scripts/migrate-recent-submissions.ts) ---
# Service account JSON with read access to the Requirements/Recruitment sheets
# and the resume Drive folder in the source Apps Script project.
GOOGLE_SERVICE_ACCOUNT_JSON="./scripts/.secrets/google-service-account.json"
GAS_SPREADSHEET_ID="1dy_GcHW1_6SNUMvWUaom3nFSJRmWiWPUD0bAJ7dz8QQ"
MIGRATION_SUBMISSION_LIMIT="100"
